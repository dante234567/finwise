// ═══════════════════════════════════════════════════════════════════════════
// Schema de Prisma para FinWise — Topología Dimensional del Motor Analítico
// ═══════════════════════════════════════════════════════════════════════════
// INVARIANTES:
//   1. Todo campo monetario o fraccionario usa Decimal (no Float) para
//      evitar divergencia IEEE 754 en el motor de punto de equilibrio.
//   2. Los modelos Breakeven y Projection fueron eliminados intencionalmente:
//      representan estados computados dinámicamente, no entidades persistibles.
//   3. Toda Transaction porta clasificación bidimensional obligatoria:
//      isFixed (Comportamiento) × isBusiness (Pertenencia).
// ═══════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────

/// Clasificación del flujo: ingreso o egreso
enum TransactionType {
  INCOME
  EXPENSE
}

// ─── Modelos ──────────────────────────────────────────────────────────────

/// Perfil del tenant — configuración fiscal y de ganancia deseada (α)
/// Vinculado 1:1 con Supabase Auth mediante authUserId
model Profile {
  id           String  @id @default(uuid())
  authUserId   String  @unique

  /// α — Porcentaje de ganancia deseada (fracción 0..0.99)
  targetMargin Decimal @db.Decimal(5, 4)

  /// T_F — Cuota fija mensual de Monotributo (mock fiscal)
  taxFixed     Decimal @db.Decimal(12, 2)

  /// t_v — Alícuota de Ingresos Brutos (fracción 0..0.99)
  taxVariable  Decimal @db.Decimal(5, 4)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  transactions Transaction[]

  @@map("profiles")
}

/// Transacción financiera con clasificación bidimensional
/// Dimensión de Comportamiento: isFixed (Fijo/Variable)
/// Dimensión de Pertenencia:    isBusiness (Negocio/Personal)
model Transaction {
  id         String          @id @default(uuid())
  profileId  String

  /// Monto absoluto de la operación — siempre positivo
  amount     Decimal         @db.Decimal(12, 2)

  /// Tipo: INCOME o EXPENSE
  type       TransactionType

  /// Concepto descriptivo libre
  concept    String

  /// Volumen de la operación (unidades vendidas/compradas)
  quantity   Int

  /// Dimensión de Comportamiento: true = Costo Fijo, false = Costo Variable
  isFixed    Boolean

  /// Dimensión de Pertenencia: true = Negocio, false = Personal
  isBusiness Boolean

  createdAt  DateTime        @default(now())

  profile    Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([createdAt])
  @@index([type])
  @@index([isBusiness, isFixed])
  @@map("transactions")
}
