// Schema de Prisma para FinWise — modelos de datos del negocio

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Usuario del sistema — vinculado a Supabase Auth por authId
model User {
  id        String   @id @default(cuid())
  authId    String   @unique
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]
  breakevens   Breakeven[]
  projections  Projection[]

  @@map("users")
}

/// Transacción financiera — ingreso o gasto del negocio
model Transaction {
  id          String   @id @default(cuid())
  userId      String
  amount      Float
  currency    String   @default("ARS")
  type        String
  category    String
  description String
  date        DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([date])
  @@map("transactions")
}

/// Análisis de punto de equilibrio del negocio
model Breakeven {
  id                  String   @id @default(cuid())
  userId              String
  name                String
  fixedCosts          Float
  variableCostPerUnit Float
  pricePerUnit        Float
  currency            String   @default("ARS")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("breakevens")
}

/// Proyección de ventas con escenarios
model Projection {
  id             String   @id @default(cuid())
  userId         String
  name           String
  monthlyRevenue Float
  growthRate     Float
  months         Int
  currency       String   @default("ARS")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("projections")
}
